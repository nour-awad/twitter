{
  "openapi": "3.1.0",
  "info": {
    "title": "Search Service",
    "description": "In-memory inverted index rebuilt by replaying the event log; trending hashtags.",
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Live",
        "description": "Liveness: is the process able to serve at all? (failure => restart pod)",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Ready",
        "description": "Readiness: are dependencies usable? (failure => stop routing traffic here)",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/internal/chaos": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Get Chaos",
        "operationId": "get_chaos_internal_chaos_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChaosConfig"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "ops"
        ],
        "summary": "Set Chaos",
        "description": "Fault injection for chaos experiments (disable with CHAOS_ENABLED=false).",
        "operationId": "set_chaos_internal_chaos_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChaosConfig"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChaosConfig"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/search/tweets": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Search Tweets",
        "operationId": "search_tweets_v1_search_tweets_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Q"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TweetHit"
                  },
                  "title": "Response Search Tweets V1 Search Tweets Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/search/users": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Search Users",
        "operationId": "search_users_v1_search_users_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Q"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "title": "Response Search Users V1 Search Users Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/trends": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Trends",
        "operationId": "trends_v1_trends_get",
        "parameters": [
          {
            "name": "window_minutes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1440,
              "title": "Window Minutes"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "default": 10,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "title": "Response Trends V1 Trends Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/search/stats": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Stats",
        "operationId": "stats_v1_search_stats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Stats V1 Search Stats Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChaosConfig": {
        "properties": {
          "error_rate": {
            "type": "number",
            "title": "Error Rate",
            "default": 0.0
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms",
            "default": 0
          }
        },
        "type": "object",
        "title": "ChaosConfig"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TweetHit": {
        "properties": {
          "tweet_id": {
            "type": "string",
            "title": "Tweet Id"
          },
          "author_id": {
            "type": "string",
            "title": "Author Id"
          },
          "author_username": {
            "type": "string",
            "title": "Author Username"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "hashtags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Hashtags"
          },
          "likes": {
            "type": "integer",
            "title": "Likes"
          },
          "retweets": {
            "type": "integer",
            "title": "Retweets"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "tweet_id",
          "author_id",
          "author_username",
          "text",
          "hashtags",
          "likes",
          "retweets",
          "created_at"
        ],
        "title": "TweetHit"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
