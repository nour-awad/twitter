{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Agent Service",
    "description": "MCP tool server (/mcp), Claude-powered agent, timeline summaries and AI moderation.",
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Live",
        "description": "Liveness: is the process able to serve at all? (failure => restart pod)",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Ready",
        "description": "Readiness: are dependencies usable? (failure => stop routing traffic here)",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/internal/chaos": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Get Chaos",
        "operationId": "get_chaos_internal_chaos_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChaosConfig"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "ops"
        ],
        "summary": "Set Chaos",
        "description": "Fault injection for chaos experiments (disable with CHAOS_ENABLED=false).",
        "operationId": "set_chaos_internal_chaos_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChaosConfig"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChaosConfig"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ai/agent": {
      "post": {
        "tags": [
          "ai"
        ],
        "summary": "Run Agent",
        "description": "Natural-language goal -> Claude plans and calls Twitter tools -> answer + tool trace.",
        "operationId": "run_agent_v1_ai_agent_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Run Agent V1 Ai Agent Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/ai/timeline-summary": {
      "post": {
        "tags": [
          "ai"
        ],
        "summary": "Timeline Summary",
        "operationId": "timeline_summary_v1_ai_timeline_summary_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Timeline Summary V1 Ai Timeline Summary Post"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/ai/compose": {
      "post": {
        "tags": [
          "ai"
        ],
        "summary": "Compose",
        "operationId": "compose_v1_ai_compose_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComposeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Compose V1 Ai Compose Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/ai/tools": {
      "get": {
        "tags": [
          "ai"
        ],
        "summary": "List Tools",
        "description": "The tool catalogue (same one MCP clients discover via tools/list).",
        "operationId": "list_tools_v1_ai_tools_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response List Tools V1 Ai Tools Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentRequest": {
        "properties": {
          "instruction": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Instruction"
          },
          "allow_actions": {
            "type": "boolean",
            "title": "Allow Actions",
            "description": "Allow tools with side effects (post, like, follow)",
            "default": false
          },
          "max_steps": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Max Steps",
            "default": 8
          }
        },
        "type": "object",
        "required": [
          "instruction"
        ],
        "title": "AgentRequest"
      },
      "ChaosConfig": {
        "properties": {
          "error_rate": {
            "type": "number",
            "title": "Error Rate",
            "default": 0.0
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms",
            "default": 0
          }
        },
        "type": "object",
        "title": "ChaosConfig"
      },
      "ComposeRequest": {
        "properties": {
          "topic": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Topic"
          },
          "tone": {
            "type": "string",
            "title": "Tone",
            "default": "friendly"
          }
        },
        "type": "object",
        "required": [
          "topic"
        ],
        "title": "ComposeRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
