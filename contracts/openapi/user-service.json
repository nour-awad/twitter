{
  "openapi": "3.1.0",
  "info": {
    "title": "User Service",
    "description": "Profiles and follow graph. REST for clients, gRPC (port 50051) for services.",
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Live",
        "description": "Liveness: is the process able to serve at all? (failure => restart pod)",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Ready",
        "description": "Readiness: are dependencies usable? (failure => stop routing traffic here)",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/internal/chaos": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Get Chaos",
        "operationId": "get_chaos_internal_chaos_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChaosConfig"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "ops"
        ],
        "summary": "Set Chaos",
        "description": "Fault injection for chaos experiments (disable with CHAOS_ENABLED=false).",
        "operationId": "set_chaos_internal_chaos_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChaosConfig"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChaosConfig"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/users/by-username/{username}": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get By Username",
        "operationId": "get_by_username_v1_users_by_username__username__get",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Username"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
